# Server Configuration
# Host the server binds to. The API speaks plain HTTP without a certificate,
# so it stays on the loopback address unless somebody opens it up on purpose.
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=10s
SERVER_IDLE_TIMEOUT=60s
# gzip for the large answers (zone geometry, region collections).
SERVER_COMPRESSION=true
SERVER_COMPRESS_THRESHOLD=1024
# How long a unit may stay silent before it counts as offline. A unit that
# reports again lifts itself back up. 0 turns the check off.
SERVER_OFFLINE_AFTER=60s
# How long a unit may stand still — while it keeps reporting — before the
# server calls it idle. Idle is not offline: an idle unit still reports, it
# just does not move. 0 turns the server-side idle detection off.
SERVER_IDLE_AFTER=10m
# How far a unit may drift from its anchor and still count as standing
# still, in meters. A larger radius absorbs the drift of a real GPS.
SERVER_IDLE_RADIUS_M=25
# The speed above which a report counts as movement, in km/h — however little
# the position moved.
SERVER_IDLE_MAX_SPEED_KMH=2

# Service reminders. The schedule of a unit is counted from its odometer: the
# next service is due when the odometer reaches the reading of the last
# service plus the interval of the unit.
# The interval a unit falls back to when it has no interval of its own, in
# kilometres. Both values have to be above 0; anything else falls back to the
# default.
SERVICE_INTERVAL_DEFAULT_KM=5000
# How close to the schedule a unit has to come before it counts as due, in
# kilometres. Past the schedule it is overdue.
SERVICE_WARN_KM=500

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=entity_management
DB_SSL_MODE=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=0
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_CONNECT_TIMEOUT=10s

# Auth Configuration
# Signing key for the tokens: openssl rand -base64 32
JWT_SECRET=
# Access token lifetime.
JWT_TTL=24h
# Refresh token lifetime: it renews the access token without a new sign-in.
JWT_REFRESH_TTL=720h

# Web Push Configuration (VAPID)
# The key pair of the server. Generate it once with:
#   go run ./cmd/gen-vapid
# and paste the two lines it prints here. Without them the Web Push feature
# is off: the server runs exactly as before and sends no push at all.
# The private key is a secret — it never goes into Git, the log or the API.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Who the sender is. The push services want a mailto: address or an https
# URL of the operator of the server. Default: mailto:admin@localhost
VAPID_SUBJECT=
